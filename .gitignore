# ─────────────────────────────────────────────────────────────
#  EcoQuest — Git Ignore Manifest
#  See: https://help.github.com/articles/ignoring-files/
# ─────────────────────────────────────────────────────────────

# ── Node.js Dependencies ────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js Build Artifacts ─────────────────────────────────
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# ── Environment & Secrets ───────────────────────────────────
# Block all local secrets — NEVER commit real credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Allow the public template so contributors know what keys to set
!.env.example

# ── Firebase Admin Credentials ──────────────────────────────
*.pem
firebase-adminsdk*.json
service-account*.json
serviceAccount*.json
.genkit/*
firebase-debug.log
firestore-debug.log
firebase-export-*

# ── OS / Editor Noise ───────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/settings.json

# ── Debug / Log Files ───────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Testing Coverage ────────────────────────────────────────
/coverage
*.lcov

# ── Vercel Deployment ───────────────────────────────────────
.vercel

# ── Screenshots — Track These in Git ────────────────────────
# public/screenshots/ is explicitly tracked for README embeds
# (no ignore rule for it — git will include it by default)
