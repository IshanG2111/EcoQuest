# ─────────────────────────────────────────────────────────────────────────────
#  EcoQuest — Environment Variables Template
#  Copy this file to .env.local and fill in your own values.
#  NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase Client SDK (Public — safe to expose in browser) ─────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (Server-side only — KEEP SECRET) ──────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the full RSA private key (including -----BEGIN/END----- markers)
# Wrap in double quotes and use \n for line breaks
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Format: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/
MONGODB_URI=

# ── NextAuth.js Session Management ───────────────────────────────────────────
# Generate a secure random secret: openssl rand -hex 32
AUTH_SECRET=
# Set to your production URL when deploying to Vercel
NEXTAUTH_URL=http://localhost:9002

# ── Google Gemini AI ──────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── EcoQuest Admin Panel ──────────────────────────────────────────────────────
# Master PIN for the Admin Knowledge Studio (6-digit number recommended)
ADMIN_MASTER_PIN=

# ── Optional: Python FastAPI Microservice (Render.com) ───────────────────────
# Only needed if running the auto-linker backend separately
# PYTHON_BACKEND_URL=https://ecograph-autolinker.onrender.com
